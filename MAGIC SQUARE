//MAGIC SQUARE
#include<iostream>
using namespace std;
void createMagicSquare(int**array,int r,int c){
   int i,j,count=1,range;
   for(i=0;i<r;i++)
      for(j=0;j<c;j++)
         array[i][j]=0;    
   range=r*c;
   i=0;
   j=c/2;
   array[i][j]=count;

   while(count < range) {
      count++;
      if((i-1)<0 && (j-1)<0)   
         i++;  
      else if((i-1)<0) {    
         i = r-1;
         j--;
      }else if((j-1)<0) {    
         j=c-1;
         i--;  
      }else if(array[i-1][j-1]!= 0)    
         i++;
      else{
         i--;
         j--;
      }
      array[i][j]=count;
   }

   for(i=0; i<r; i++) {
      for(j=0;j<c;j++)
         cout<<array[i][j]<<"  ";
      cout<<endl;
   }
}

main() {
   int**matrix;
   int row, col;
   cout<<"Enter number:";
   cin>>row;
   col=row;
   
   matrix=new int*[row];
   
   for(int i = 0; i<row; i++) {
      matrix[i] = new int[col];
   }
   createMagicSquare(matrix, row, col);
}
