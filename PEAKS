//PEAKS
#include<iostream>
using namespace std;
int findpeakin1D(int arr[],int n)
{
int s=0;
int e=n-1;
int mid=(s+e)/2;
while(s<=e){
    if (arr[mid]>=arr[mid-1] && arr[mid]>=arr[mid+1])
    {
        return arr[mid];
    }
    else if(arr[mid]<arr[mid-1]) {
        e=mid-1;
    }
    else if(arr[mid]<arr[mid+1]) {
        s=mid+1;
    }
    mid=(s+e)/2;
}

}
int main()
{
    int arr[]={4,54,17,9,82,45,80};
    int ans=findpeakin1D(arr,7);
    cout<<"The Peak is:"<<ans;
